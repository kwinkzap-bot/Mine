# Get these from https://kite.trade/connect/login
# API_KEY: Your application's public key (permanent)
API_KEY=6ve0bybr5a3v6tyo

# API_SECRET: Your application's secret key (permanent) - KEEP THIS CONFIDENTIAL!
# This should be DIFFERENT from API_KEY and REQUEST_TOKEN
# Get from: https://kite.trade/apps/myapps
API_SECRET=20otyxm2rq1i8wp61301rgghcy8pzq9n

# REQUEST_TOKEN: Temporary token from OAuth callback (auto-generated, ~10 min lifetime)
# This is automatically obtained when user logs in via /login
# DO NOT hardcode this - it comes from Zerodha OAuth
REQUEST_TOKEN=KuU1PDg1uo4gNzMGYGo4AFkaOLSs5KcR

# ACCESS_TOKEN: Long-lived token for API calls (365 days)
# This is automatically generated and saved by /callback route after login
# Format: kite.generate_session(request_token, api_secret)
ACCESS_TOKEN=1GyqGg4q14W56zXzHrthT1GFGVRC7j1K
# ============================================
# KOTAK NEO TRADING CREDENTIALS
# ============================================
# Official Guide: https://www.notion.so/Getting-started-15-min-28eda70d37e280a09158f091b369561e

# KOTAK_ACCESS_TOKEN: Get from Kotak Neo → API Dashboard → Access Token
# This is your permanent API access token (NOT consumer_key!)
KOTAK_ACCESS_TOKEN=7157395b-6495-4b0f-91aa-f7dcb5a2b6f9

# KOTAK_UCC: Unique Client Code (5 characters, e.g., XV5PK)
# Find: Kotak Neo App/Web → Profile → Client Code
KOTAK_UCC=XV5PK

# KOTAK_MOBILE_NUMBER: Your registered mobile number (10 digits, without +91)
KOTAK_MOBILE_NUMBER=8880802168

# KOTAK_MPIN: Your 6-digit trading PIN (used in app to authorize orders)
KOTAK_MPIN=491988

# === Auto-generated tokens (saved after successful authentication) ===
KOTAK_TRADING_TOKEN=
KOTAK_TRADING_SID=
KOTAK_BASE_URL=

