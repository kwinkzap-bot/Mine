# ============================================
# FYERS TRADING CREDENTIALS
# ============================================
# Official Guide: https://myapi.fyers.in/docsv3

# FYERS_APP_ID: Your App ID from Fyers Dashboard (format: XXXXXXXXX-100)
# Get from: https://myapi.fyers.in/dashboard/ → Create APP
FYERS_APP_ID=

# FYERS_SECRET_KEY: Your App Secret Key (KEEP CONFIDENTIAL)
# Get from: https://myapi.fyers.in/dashboard/ → App Details
FYERS_SECRET_KEY=

# FYERS_ACCESS_TOKEN: Generated access token (format: appid:token or just token)
# Generated via OAuth flow after user authorization
FYERS_ACCESS_TOKEN=

# FYERS_REDIRECT_URI: Redirect URI for OAuth callback
# Must match the redirect URI set in your Fyers APP
FYERS_REDIRECT_URI=https://127.0.0.1