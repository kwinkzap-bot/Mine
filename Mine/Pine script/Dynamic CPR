r1_color = input.color(SR_COLOR, "R1", inline="S1/R1", group="CPR levels")
s2_color = input.color(#1b9981, "S2", inline="S2/R2" , group="CPR levels")
r2_color = input.color(#e91e63, "R2", inline="S2/R2", group="CPR levels")
