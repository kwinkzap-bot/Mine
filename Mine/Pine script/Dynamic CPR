// Track current session's running high/low/close dynamically (updates every bar/tick)
var float ns_running_high = na
var float ns_running_low = na
if is_time_change
    ns_running_high := high
    ns_running_low := low
else
    ns_running_high := math.max(nz(ns_running_high, high), high)
    ns_running_low := math.min(nz(ns_running_low, low), low)

next_session_show = input.bool(false, "Show Next Session Pivot", group="Next Session")
next_session_holidays = input.string("", "Holiday List (YYYY-MM-DD, comma separated)", group="Next Session", tooltip="Optional exchange holidays to skip for Daily next-session projection. Example: 2026-03-03,2026-03-18")

var next_lines = array.new_line()
var next_labels = array.new_label()
var next_boxes = array.new_box()

is_configured_holiday(ts) =>
    bool is_holiday = false
    if not na(ts)
        int key = year(ts, "Asia/Kolkata") * 10000 + month(ts, "Asia/Kolkata") * 100 + dayofmonth(ts, "Asia/Kolkata")
        holiday_tokens = str.split(next_session_holidays, ",")
        for hi = 0 to array.size(holiday_tokens) - 1
            token_raw = str.trim(array.get(holiday_tokens, hi))
            token = str.replace_all(token_raw, "-", "")
            if str.length(token) == 8
                token_num = int(str.tonumber(token))
                if token_num == key
                    is_holiday := true
    is_holiday

// Clear and redraw on EVERY real-time update for dynamic levels
if barstate.islast and next_session_show and array.size(arr_time) > 0
    // Clear previous next session drawings
    while array.size(next_lines) > 0
        line.delete(array.pop(next_lines))
    while array.size(next_labels) > 0
        label.delete(array.pop(next_labels))
    while array.size(next_boxes) > 0
        box.delete(array.pop(next_boxes))
    
    // Use running session values (dynamic, updates every tick)
    float curr_high = ns_running_high
    float curr_low = ns_running_low
    float curr_close = close
    
    if not na(curr_high) and not na(curr_low) and not na(curr_close)
        // Calculate next session time range (dynamic per resolution)
        j = array.size(arr_time) - 2
        int ns_start = na
        int ns_end = na
        
        if resolution == "D"
            // Daily: project to next trading day and draw levels for FULL market session (09:00 - 15:30 IST)
            // Example: If current day is March 4th, next session pivot should show for entire March 5th (or next working day)
            // Build next date from current bar time, skipping weekends + configured holidays.
            int one_day_ms = 24 * 60 * 60 * 1000
            
            // Get current day's start time in IST
            int current_day_start = nz(time("D"), time)
            int candidate_day = current_day_start + one_day_ms
            int guard = 0

            // Skip weekends and configured holidays (guarded loop)
            while not na(candidate_day) and guard < 20 and (
                 dayofweek(candidate_day, "Asia/Kolkata") == dayofweek.saturday or
                 dayofweek(candidate_day, "Asia/Kolkata") == dayofweek.sunday or
                 is_configured_holiday(candidate_day)
                 )
                candidate_day += one_day_ms
                guard += 1

            if not na(candidate_day)
                next_y = year(candidate_day, "Asia/Kolkata")
                next_m = month(candidate_day, "Asia/Kolkata")
                next_d = dayofmonth(candidate_day, "Asia/Kolkata")

                // Next session starts at 9:00 AM IST and ends at 3:30 PM IST (full trading session)
                ns_start := timestamp("Asia/Kolkata", next_y, next_m, next_d, 9, 0, 0)
                ns_end   := timestamp("Asia/Kolkata", next_y, next_m, next_d, 15, 30, 0)

            // Safety fallback (if timezone/date extraction returns na for any reason)
            if na(ns_start) or na(ns_end) or ns_end <= ns_start
                int daily_start = time("D")
                if not na(daily_start)
                    // fallback projection: approximate next session window from next calendar day
                    ns_start := daily_start + one_day_ms + (9 * 60) * 60 * 1000
                    ns_end   := daily_start + one_day_ms + (15 * 60 + 30) * 60 * 1000
            
            // Final fallback to visible projection window to ensure drawing is not skipped
            if na(ns_start) or na(ns_end) or ns_end <= ns_start
                ns_start := time + one_day_ms
                ns_end := ns_start + (6 * 60 + 30) * 60 * 1000
        else
            // Weekly/Monthly/Quarterly/etc: project to the NEXT session
            int cur_s_start = array.get(arr_time, j + 1)
            string tz = "Asia/Kolkata"
            int one_day_ms = 86400000
            
            if (resolution == "W" or resolution == "1W") and j >= 0
                // Find next Monday
                int candidate = cur_s_start + (2 * one_day_ms)
                while dayofweek(candidate, tz) != dayofweek.monday
                    candidate += one_day_ms
                ns_start := candidate
                ns_end   := ns_start + (5 * one_day_ms)
            else if (resolution == "M" or resolution == "1M") and j >= 0
                // Find first day of next month
                int y = year(cur_s_start, tz)
                int m = month(cur_s_start, tz)
                int nm = m == 12 ? 1 : m + 1
                int ny = m == 12 ? y + 1 : y
                ns_start := timestamp(tz, ny, nm, 1, 9, 0, 0)
                ns_end   := timestamp(tz, ny, nm, 28, 15, 30, 0)
            else
                // Generic duration-based projection
                int duration = j >= 0 ? cur_s_start - array.get(arr_time, j) : one_day_ms
                ns_start := cur_s_start + duration
                ns_end   := ns_start + duration
        
        if not na(ns_start) and not na(ns_end) and ns_end > ns_start
            // Always use bar_time for proper time-based projection
            // This ensures Daily CPR next session lines appear at the actual next day's time (9:00 AM - 3:30 PM IST)
            next_xloc = xloc.bar_time

            int x1_next = ns_start
            int x2_next = ns_end

            // === Calculate Next Session CPR ===
            ns_pivot = (curr_high + curr_low + curr_close) / 3
            ns_bc = (curr_high + curr_low) / 2
            ns_tc = ns_pivot * 2 - ns_bc
            if ns_bc > ns_tc
                temp = ns_bc
                ns_bc := ns_tc
                ns_tc := temp
        
            // === R1, S1 (Traditional) ===
            ns_r1 = ns_pivot * 2 - curr_low
            ns_s1 = ns_pivot * 2 - curr_high
            ns_r2 = ns_pivot + (curr_high - curr_low)
            ns_s2 = ns_pivot - (curr_high - curr_low)
            ns_r3 = ns_r1 + (curr_high - curr_low)
            ns_s3 = ns_s1 - (curr_high - curr_low)
            ns_r4 = ns_r3 + (curr_high - curr_low)
            ns_s4 = ns_s3 - (curr_high - curr_low)
        
            // === Camarilla R3, S3 ===
            ns_cam_range = curr_high - curr_low
            ns_cam_r3 = curr_close + ns_cam_range * 1.1 / 4.0
            ns_cam_s3 = curr_close - ns_cam_range * 1.1 / 4.0
        
            // === R0.5, S0.5 ===
            ns_r05 = (ns_pivot + ns_r1) / 2
            ns_s05 = (ns_pivot + ns_s1) / 2
        
            // === R0.25, S0.25 (Quarter Lines) ===
            ns_rq = ns_r05 + (curr_high - ns_r05) / 4
            ns_sq = ns_s05 - (ns_s05 - curr_low) / 4
        
            // Dashed style for next session lines (same colors as current day)
            ns_line_style = line.style_dashed
        
            // --- Draw CPR (P, TC, BC) --- same color as current CPR
            l_p = line.new(x1_next, ns_pivot, x2_next, ns_pivot, color=cpr_color, xloc=next_xloc, width=line_width, style=ns_line_style)
            l_tc = line.new(x1_next, ns_tc, x2_next, ns_tc, color=cpr_color, xloc=next_xloc, width=line_width, style=ns_line_style)
            l_bc = line.new(x1_next, ns_bc, x2_next, ns_bc, color=cpr_color, xloc=next_xloc, width=line_width, style=ns_line_style)
            linefill.new(l_tc, l_bc, color.new(cpr_color, 95))
            array.push(next_lines, l_p)
            array.push(next_lines, l_tc)
            array.push(next_lines, l_bc)
        
            // CPR Labels
            array.push(next_labels, label.new(x=x2_next, y=ns_pivot, text="  P*", textcolor=cpr_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            array.push(next_labels, label.new(x=x2_next, y=ns_tc, text="  TC*", textcolor=cpr_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            array.push(next_labels, label.new(x=x2_next, y=ns_bc, text="  BC*", textcolor=cpr_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
        
            // --- Draw R1 / Prev High Box --- same color as current R1 box
            ns_r1_top = math.max(ns_r1, curr_high)
            ns_r1_bot = math.min(ns_r1, curr_high)
            ns_box_r1 = box.new(x1_next, ns_r1_top, x2_next, ns_r1_bot, border_color=r1_border_color, bgcolor=r1_bg_color, border_width=2, border_style=line.style_dashed, xloc=next_xloc)
            array.push(next_boxes, ns_box_r1)
            if ns_r1 >= curr_high
                array.push(next_labels, label.new(x=x2_next, y=ns_r1, text="  R1*", textcolor=r1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
                array.push(next_labels, label.new(x=x2_next, y=curr_high, text="  Prev H*", textcolor=r1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            else
                array.push(next_labels, label.new(x=x2_next, y=curr_high, text="  Prev H*", textcolor=r1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
                array.push(next_labels, label.new(x=x2_next, y=ns_r1, text="  R1*", textcolor=r1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
        
            // --- Draw S1 / Prev Low Box --- same color as current S1 box
            ns_s1_top = math.max(ns_s1, curr_low)
            ns_s1_bot = math.min(ns_s1, curr_low)
            ns_box_s1 = box.new(x1_next, ns_s1_top, x2_next, ns_s1_bot, border_color=s1_border_color, bgcolor=s1_bg_color, border_width=2, border_style=line.style_dashed, xloc=next_xloc)
            array.push(next_boxes, ns_box_s1)
            if ns_s1 <= curr_low
                array.push(next_labels, label.new(x=x2_next, y=ns_s1, text="  S1*", textcolor=s1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
                array.push(next_labels, label.new(x=x2_next, y=curr_low, text="  Prev L*", textcolor=s1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            else
                array.push(next_labels, label.new(x=x2_next, y=curr_low, text="  Prev L*", textcolor=s1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
                array.push(next_labels, label.new(x=x2_next, y=ns_s1, text="  S1*", textcolor=s1_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
        
            // --- Draw R2 to R4 and S2 to S4 Lines ---
            l_ns_r2 = line.new(x1_next, ns_r2, x2_next, ns_r2, color=r2_color, xloc=next_xloc, width=line_width, style=line.style_dashed)
            l_ns_s2 = line.new(x1_next, ns_s2, x2_next, ns_s2, color=s2_color, xloc=next_xloc, width=line_width, style=line.style_dashed)
            array.push(next_lines, l_ns_r2)
            array.push(next_lines, l_ns_s2)
            array.push(next_labels, label.new(x=x2_next, y=ns_r2, text="  R2*", textcolor=r2_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            array.push(next_labels, label.new(x=x2_next, y=ns_s2, text="  S2*", textcolor=s2_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            
            l_ns_r3 = line.new(x1_next, ns_r3, x2_next, ns_r3, color=r3_color, xloc=next_xloc, width=line_width, style=line.style_dashed)
            l_ns_s3 = line.new(x1_next, ns_s3, x2_next, ns_s3, color=s3_color, xloc=next_xloc, width=line_width, style=line.style_dashed)
            array.push(next_lines, l_ns_r3)
            array.push(next_lines, l_ns_s3)
            array.push(next_labels, label.new(x=x2_next, y=ns_r3, text="  R3*", textcolor=r3_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            array.push(next_labels, label.new(x=x2_next, y=ns_s3, text="  S3*", textcolor=s3_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            
            l_ns_r4 = line.new(x1_next, ns_r4, x2_next, ns_r4, color=r4_color, xloc=next_xloc, width=line_width, style=line.style_dashed)
            l_ns_s4 = line.new(x1_next, ns_s4, x2_next, ns_s4, color=s4_color, xloc=next_xloc, width=line_width, style=line.style_dashed)
            array.push(next_lines, l_ns_r4)
            array.push(next_lines, l_ns_s4)
            array.push(next_labels, label.new(x=x2_next, y=ns_r4, text="  R4*", textcolor=r4_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
            array.push(next_labels, label.new(x=x2_next, y=ns_s4, text="  S4*", textcolor=s4_color, style=label.style_none, color=#00000000, size=size.small, xloc=next_xloc))
        
            // --- Draw C-R3, C-S3 Lines --- same color as current C-R3/C-S3
            l_cr3 = line.new(x1_next, ns_cam_r3, x2_next, ns_cam_r3, color=cam_r3_color, xloc=next_xloc, width=2, style=line.style_dashed)
            l_cs3 = line.new(x1_next, ns_cam_s3, x2_next, ns_cam_s3, color=cam_s3_color, xloc=next_xloc, width=2, style=line.style_dashed)
