// ============================================================================
// DELTA-RSI FILTER TABLE  (Daily Timeframe)
// Ported from Delta-RSI Oscillator (© tbiktag, MPL 2.0)
// D-RSI = smoothed time-derivative of RSI via linear regression slope.
// Always evaluated on the Daily candle regardless of chart timeframe.
// ============================================================================

drsi_show       = input.bool(true,  "Show D-RSI Filter Table",    group="Delta-RSI Filter")
drsi_rsi_len    = input.int(21,     "RSI Length",                  group="Delta-RSI Filter", minval=1)
drsi_window     = input.int(21,     "D-RSI Window (LinReg)",       group="Delta-RSI Filter", minval=2)
drsi_signal_len = input.int(9,      "Signal Length (EMA)",         group="Delta-RSI Filter", minval=1)
drsi_cond       = input.string("Zero-Crossing", "Signal Condition", group="Delta-RSI Filter",
                   options=["Zero-Crossing", "Signal Line Crossing", "Direction Change"],
                   tooltip="Zero-Crossing: D-RSI crosses 0 | Signal Line: D-RSI crosses its EMA | Direction Change: D-RSI reverses while negative/positive")

// ── Daily D-RSI calculation (wrapped for request.security) ──────────────────
// The derivative of RSI is approximated as the slope of its linear regression:
//   drsi ≈ linreg(rsi, n, 0) - linreg(rsi, n, 1)
// This is equivalent to the polynomial-regression derivative at degree=1,
// and provides the same directional information for daily-timeframe filtering.
daily_drsi_fn() =>
    _rsi    = ta.rsi(close, drsi_rsi_len)
    _drsi   = ta.linreg(_rsi, drsi_window, 0) - ta.linreg(_rsi, drsi_window, 1)
    _signal = ta.ema(_drsi, drsi_signal_len)
    [_drsi, _signal, _rsi]

[d_drsi, d_signal, d_rsi] = request.security(syminfo.tickerid, "D", daily_drsi_fn())

// ── Signal conditions ────────────────────────────────────────────────────────
d_crossup       = ta.crossover(d_drsi,  0.0)
d_crossdw       = ta.crossunder(d_drsi, 0.0)
d_crosssigup    = ta.crossover(d_drsi,  d_signal)
d_crosssigdw    = ta.crossunder(d_drsi, d_signal)
d_dirchangeup   = (d_drsi > d_drsi[1]) and (d_drsi[1] < d_drsi[2]) and d_drsi[1] < 0.0
d_dirchangedw   = (d_drsi < d_drsi[1]) and (d_drsi[1] > d_drsi[2]) and d_drsi[1] > 0.0

d_golong  = drsi_cond == "Direction Change"     ? d_dirchangeup  :
            drsi_cond == "Signal Line Crossing"  ? d_crosssigup   : d_crossup
d_goshort = drsi_cond == "Direction Change"     ? d_dirchangedw  :
            drsi_cond == "Signal Line Crossing"  ? d_crosssigdw   : d_crossdw

// ── Persistent state: track last active signal ───────────────────────────────
var bool d_in_long  = false
var bool d_in_short = false

if d_golong
    d_in_long  := true
    d_in_short := false
if d_goshort
    d_in_short := true
    d_in_long  := false

// ── Two-column table (redrawn on last bar) ───────────────────────────────────
var table drsi_tbl = na

if barstate.islast and drsi_show
    if not na(drsi_tbl)
        table.delete(drsi_tbl)

    drsi_tbl := table.new(
         position.top_right, 2, 5,
         bgcolor      = color.new(color.black, 75),
         border_color = color.new(color.gray,  50),
         border_width = 1,
         frame_color  = color.new(color.gray,  30),
         frame_width  = 1)

    // ── Row 0: column headers ──
    table.cell(drsi_tbl, 0, 0, "🟢  LONG  (Daily D-RSI)",
         text_color = color.white,
         bgcolor    = color.new(color.green, 55),
         text_size  = size.small)
    table.cell(drsi_tbl, 1, 0, "🔴  SHORT  (Daily D-RSI)",
         text_color = color.white,
         bgcolor    = color.new(color.red, 55),
         text_size  = size.small)

    // ── Row 1: Daily RSI value ──
    rsi_disp = "RSI(D): " + str.tostring(math.round(d_rsi, 1))
    table.cell(drsi_tbl, 0, 1, rsi_disp, text_color=color.silver, text_size=size.tiny)
    table.cell(drsi_tbl, 1, 1, rsi_disp, text_color=color.silver, text_size=size.tiny)

    // ── Row 2: D-RSI and Signal values ──
    drsi_disp = "D-RSI: " + str.tostring(math.round(d_drsi,   4)) +
                "   Sig: " + str.tostring(math.round(d_signal, 4))
    table.cell(drsi_tbl, 0, 2, drsi_disp, text_color=color.gray, text_size=size.tiny)
    table.cell(drsi_tbl, 1, 2, drsi_disp, text_color=color.gray, text_size=size.tiny)

    // ── Row 3: Condition label ──
    table.cell(drsi_tbl, 0, 3, "Cond: " + drsi_cond, text_color=color.gray, text_size=size.tiny)
    table.cell(drsi_tbl, 1, 3, "Cond: " + drsi_cond, text_color=color.gray, text_size=size.tiny)

    // ── Row 4: Signal status ── (the main signal row)
    long_txt  = d_in_long  ? "✅   BUY   ACTIVE" : "—"
    short_txt = d_in_short ? "✅   SELL   ACTIVE" : "—"
    long_bg   = d_in_long  ? color.new(color.green, 25) : color.new(color.black, 80)
    short_bg  = d_in_short ? color.new(color.red,   25) : color.new(color.black, 80)
    long_tc   = d_in_long  ? color.white : color.new(color.gray, 40)
    short_tc  = d_in_short ? color.white : color.new(color.gray, 40)

    table.cell(drsi_tbl, 0, 4, long_txt,
         text_color = long_tc,  bgcolor = long_bg,  text_size = size.normal)
    table.cell(drsi_tbl, 1, 4, short_txt,
         text_color = short_tc, bgcolor = short_bg, text_size = size.normal)
