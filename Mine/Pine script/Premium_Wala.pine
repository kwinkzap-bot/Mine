// @version=5
// =============================================================================
// Premium_Wala -- CE + PE Combined Premium Tracker
// =============================================================================

indicator("Premium_Wala", shorttitle="Premium_Wala", overlay=false, max_labels_count=40)

// ─────────────────────────────────────────────────────────────────────────────
// ◆ INPUTS
// ─────────────────────────────────────────────────────────────────────────────
grp = "CE + PE SYSTEM"

enable_sys = input.bool(true,     "Enable CE+PE System",   group=grp)
unl        = input.string("NIFTY","Underlying", options=["NIFTY","BANKNIFTY","FINNIFTY"], group=grp)
expiry     = input.string("260330","Expiry (YYMMDD)",      group=grp)
atm_strike = input.int(23300,    "ATM Strike",            group=grp)

show_t1    = input.bool(true,     "Show Target Premium 1", group=grp)
show_t2    = input.bool(true,     "Show Target Premium 2", group=grp)

tgt_strike = input.int(50,        "Target Strike Distance", group=grp, tooltip="Used to calculate the dynamic premium target offset (e.g., 50 for T1, 100 for T2)")

show_lbl   = input.bool(true,     "Show Labels",           group=grp)

show_ce    = input.bool(true,     "Show CE Candles",       group="Visuals")
show_pe    = input.bool(true,     "Show PE Candles",       group="Visuals")

// ─────────────────────────────────────────────────────────────────────────────
// ◆ DATA FETCH & SYMBOL BUILD
// ─────────────────────────────────────────────────────────────────────────────
f_sym(stk, type) => "NSE:" + unl + expiry + type + str.tostring(stk)

ce_sym = f_sym(atm_strike, "C")
pe_sym = f_sym(atm_strike, "P")

[ce_o, ce_h, ce_l, ce_c, ce_v] = request.security(ce_sym, timeframe.period, [open, high, low, close, volume], barmerge.gaps_off, barmerge.lookahead_off)
[pe_o, pe_h, pe_l, pe_c, pe_v] = request.security(pe_sym, timeframe.period, [open, high, low, close, volume], barmerge.gaps_off, barmerge.lookahead_off)

// ─────────────────────────────────────────────────────────────────────────────
// ◆ THE "ACCURACY" ENGINE
// ─────────────────────────────────────────────────────────────────────────────

// Helper: Daily VWAP
f_dvwap(p, v) =>
    var float cpv = 0.0, var float cv = 0.0
    if ta.change(time("D"))
        cpv := 0.0
        cv := 0.0
    if not na(p) and not na(v)
        cpv += p * v
        cv += v
    cv > 0 ? cpv / cv : na

// VWAP for individual legs
ce_vwap = f_dvwap(ce_c, ce_v)
pe_vwap = f_dvwap(pe_c, pe_v)

// Entry and Live Premiums (Averaged to match the CE/PE axis scale perfectly as shown in image)
live_prem = (ce_c + pe_c) / 2.0
entry_curve = (ce_vwap + pe_vwap) / 2.0

// --- OPTION PREMIUM DYNAMIC TARGET LOGIC ---
// The targets are derived directly from the user-defined Target Strike Distance.
// If the input is 50, Target 1 is at Entry + 50, and Target 2 is at Entry + 100.
t1_offset = float(tgt_strike)
t2_offset = float(tgt_strike) * 2.0

// The target flawlessly and stably mirrors the VWAP curve.
t1_val = entry_curve + t1_offset
t2_val = entry_curve + t2_offset

// ─────────────────────────────────────────────────────────────────────────────
// ◆ CANDLE PLOTS
// ─────────────────────────────────────────────────────────────────────────────

// CE Candles: Green (Up) / Red (Down)
ce_clr = ce_c >= ce_o ? color.new(#1b9981, 0) : color.new(#f23645, 0)
plotcandle(show_ce ? ce_o : na, ce_h, ce_l, ce_c, "CE Candles", ce_clr, ce_clr, bordercolor=ce_clr)

// PE Candles: Blue (Up) / Black (Down)
pe_clr = pe_c >= pe_o ? color.new(#1f77d2, 0) : color.new(#000000, 0)
plotcandle(show_pe ? pe_o : na, pe_h, pe_l, pe_c, "PE Candles", pe_clr, pe_clr, bordercolor=pe_clr)

// Leg Labels on Axis
plot(ce_c, "CE Axis", color=color.new(#2196f3, 100), display=display.price_scale)
plot(pe_c, "PE Axis", color=color.new(#e91e63, 100), display=display.price_scale)

// ─────────────────────────────────────────────────────────────────────────────
// ◆ FINAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

// Plot the tracking lines
plot(enable_sys ? entry_curve : na, "Entry Premium", color=#4caf50, linewidth=2, display=display.all)
plot(enable_sys ? live_prem : na,  "Current Premium", color=#2196f3, linewidth=2, display=display.all)
plot(enable_sys and show_t1 ? t1_val : na, "Target Premium 1", color=#e040fb, linewidth=1, display=display.all)
plot(enable_sys and show_t2 ? t2_val : na, "Target Premium 2", color=color.orange, linewidth=1, display=display.all)

// ─────────────────────────────────────────────────────────────────────────────
// ◆ LABELS
// ─────────────────────────────────────────────────────────────────────────────

// Custom label function allowing specific text colors (yellow background needs black text)
f_lbl(y, txt, bg_clr, txt_clr) => 
    label.new(bar_index + 4, y, txt + "   " + str.tostring(math.round(y, 2)), style=label.style_label_left, color=bg_clr, textcolor=txt_clr, size=size.small)

var label lE = na, var label lC = na, var label l1 = na, var label l2 = na
if barstate.islast and enable_sys and show_lbl
    label.delete(lE), label.delete(lC), label.delete(l1), label.delete(l2)
    lE := f_lbl(entry_curve, "Entry Premium", #4caf50, color.white)
    lC := f_lbl(live_prem,   "Current Premium", #2196f3, color.white)
    if show_t1
        l1 := f_lbl(t1_val,  "Target Premium 1", #e040fb, color.white)
    if show_t2
        l2 := f_lbl(t2_val,  "Target Premium 2", color.orange, color.white)

// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────────
// ◆ STRIKE PRICE STAMP (BOTTOM RIGHT)
// ─────────────────────────────────────────────────────────────────────────────

f_bold_unicode(txt) =>
    s = txt
    s := str.replace_all(s, "A", "𝗔"), s := str.replace_all(s, "B", "𝗕"), s := str.replace_all(s, "C", "𝗖")
    s := str.replace_all(s, "D", "𝗗"), s := str.replace_all(s, "E", "𝗘"), s := str.replace_all(s, "F", "𝗙")
    s := str.replace_all(s, "G", "𝗚"), s := str.replace_all(s, "H", "𝗛"), s := str.replace_all(s, "I", "𝗜")
    s := str.replace_all(s, "J", "𝗝"), s := str.replace_all(s, "K", "𝗞"), s := str.replace_all(s, "L", "𝗟")
    s := str.replace_all(s, "M", "𝗠"), s := str.replace_all(s, "N", "𝗡"), s := str.replace_all(s, "O", "𝗢")
    s := str.replace_all(s, "P", "𝗣"), s := str.replace_all(s, "Q", "𝗤"), s := str.replace_all(s, "R", "𝗥")
    s := str.replace_all(s, "S", "𝗦"), s := str.replace_all(s, "T", "𝗧"), s := str.replace_all(s, "U", "𝗨")
    s := str.replace_all(s, "V", "𝗩"), s := str.replace_all(s, "W", "𝗪"), s := str.replace_all(s, "X", "𝗫")
    s := str.replace_all(s, "Y", "𝗬"), s := str.replace_all(s, "Z", "𝗭"), s := str.replace_all(s, "0", "𝟬")
    s := str.replace_all(s, "1", "𝟭"), s := str.replace_all(s, "2", "𝟮"), s := str.replace_all(s, "3", "𝟯")
    s := str.replace_all(s, "4", "𝟰"), s := str.replace_all(s, "5", "𝟱"), s := str.replace_all(s, "6", "𝟲")
    s := str.replace_all(s, "7", "𝟳"), s := str.replace_all(s, "8", "𝟴"), s := str.replace_all(s, "9", "𝟵")
    s

var table stamp_tbl = table.new(position.bottom_right, 1, 1, bgcolor=color.new(color.black, 0), frame_color=color.gray, frame_width=1)
if barstate.islast
    stamp_txt = f_bold_unicode(unl + " " + str.tostring(atm_strike))
    table.cell(stamp_tbl, 0, 0, stamp_txt, text_color=color.white, text_size=size.normal)
