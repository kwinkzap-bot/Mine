//@version=5
indicator("Options Strike Selector", shorttitle="Strike Selector", overlay=false, max_labels_count=50)

// -----------------------------------------------------------------------------
// NOTE:
// TradingView option symbols can vary by broker/feed format.
// This script builds symbols as: NSE:<UNDERLYING><YYMMDD><C/P><STRIKE>
// Example: NSE:NIFTY260302C24850 (format: C=Call, P=Put)
// If your feed uses a different format, update symbol_build() accordingly.
// -----------------------------------------------------------------------------

underlying = input.string("NIFTY", "Underlying", options=["NIFTY", "BANKNIFTY"])
expiry_code = input.string("260302", "Expiry Code (example: 260302 format YYMMDD)")
exchange_prefix = input.string("NSE:", "Exchange Prefix")
auto_atm_strike = input.bool(true, "Auto ATM Strike (as per current spot price)")

// Spot symbols used for ATM detection
nifty_spot_symbol = input.string("NSE:NIFTY", "NIFTY Spot Symbol")

// Current spot and ATM strike logic
spot_symbol = nifty_spot_symbol
spot_close = request.security(spot_symbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

strike_step = underlying == "NIFTY" ? 50.0 : 100.0
atm_strike_num = int(math.round(spot_close / strike_step) * strike_step)
atm_strike = str.tostring(atm_strike_num)

// IMPORTANT: Use manually input strikes for symbols (simple strings required by request.security)
manual_ce_strike = input.string("23400", "CE Strike", options=["20000","20050","20100","20150","20200","20250","20300","20350","20400","20450","20500","20550","20600","20650","20700","20750","20800","20850","20900","20950","21000","21050","21100","21150","21200","21250","21300","21350","21400","21450","21500","21550","21600","21650","21700","21750","21800","21850","21900","21950","22000","22050","22100","22150","22200","22250","22300","22350","22400","22450","22500","22550","22600","22650","22700","22750","22800","22850","22900","22950","23000","23050","23100","23150","23200","23250","23300","23350","23400","23450","23500","23550","23600","23650","23700","23750","23800","23850","23900","23950","24000","24050","24100","24150","24200","24250","24300","24350","24400","24450","24500","24550","24600","24650","24700","24750","24800","24850","24900","24950","25000","25050","25100","25150","25200","25250","25300","25350","25400","25450","25500","25550","25600","25650","25700","25750","25800","25850","25900","25950","26000","26050","26100","26150","26200","26250","26300","26350","26400","26450","26500","26550","26600","26650","26700","26750","26800","26850","26900","26950","27000","27050","27100","27150","27200","27250","27300","27350","27400","27450","27500","27550","27600","27650","27700","27750","27800","27850","27900","27950","28000","28050","28100","28150","28200","28250","28300","28350","28400","28450","28500","28550","28600","28650","28700","28750","28800","28850","28900","28950","29000","29050","29100","29150","29200","29250","29300","29350","29400","29450","29500","29550","29600","29650","29700","29750","29800","29850","29900","29950","30000"])
manual_pe_strike = input.string("23400", "PE Strike", options=["20000","20050","20100","20150","20200","20250","20300","20350","20400","20450","20500","20550","20600","20650","20700","20750","20800","20850","20900","20950","21000","21050","21100","21150","21200","21250","21300","21350","21400","21450","21500","21550","21600","21650","21700","21750","21800","21850","21900","21950","22000","22050","22100","22150","22200","22250","22300","22350","22400","22450","22500","22550","22600","22650","22700","22750","22800","22850","22900","22950","23000","23050","23100","23150","23200","23250","23300","23350","23400","23450","23500","23550","23600","23650","23700","23750","23800","23850","23900","23950","24000","24050","24100","24150","24200","24250","24300","24350","24400","24450","24500","24550","24600","24650","24700","24750","24800","24850","24900","24950","25000","25050","25100","25150","25200","25250","25300","25350","25400","25450","25500","25550","25600","25650","25700","25750","25800","25850","25900","25950","26000","26050","26100","26150","26200","26250","26300","26350","26400","26450","26500","26550","26600","26650","26700","26750","26800","26850","26900","26950","27000","27050","27100","27150","27200","27250","27300","27350","27400","27450","27500","27550","27600","27650","27700","27750","27800","27850","27900","27950","28000","28050","28100","28150","28200","28250","28300","28350","28400","28450","28500","28550","28600","28650","28700","28750","28800","28850","28900","28950","29000","29050","29100","29150","29200","29250","29300","29350","29400","29450","29500","29550","29600","29650","29700","29750","29800","29850","29900","29950","30000"])

// Straddle input
show_straddle = input.bool(false, "Show Straddle")
straddle_strike = input.string("24850", "Straddle Strike", options=["20000","20050","20100","20150","20200","20250","20300","20350","20400","20450","20500","20550","20600","20650","20700","20750","20800","20850","20900","20950","21000","21050","21100","21150","21200","21250","21300","21350","21400","21450","21500","21550","21600","21650","21700","21750","21800","21850","21900","21950","22000","22050","22100","22150","22200","22250","22300","22350","22400","22450","22500","22550","22600","22650","22700","22750","22800","22850","22900","22950","23000","23050","23100","23150","23200","23250","23300","23350","23400","23450","23500","23550","23600","23650","23700","23750","23800","23850","23900","23950","24000","24050","24100","24150","24200","24250","24300","24350","24400","24450","24500","24550","24600","24650","24700","24750","24800","24850","24900","24950","25000","25050","25100","25150","25200","25250","25300","25350","25400","25450","25500","25550","25600","25650","25700","25750","25800","25850","25900","25950","26000","26050","26100","26150","26200","26250","26300","26350","26400","26450","26500","26550","26600","26650","26700","26750","26800","26850","26900","26950","27000","27050","27100","27150","27200","27250","27300","27350","27400","27450","27500","27550","27600","27650","27700","27750","27800","27850","27900","27950","28000","28050","28100","28150","28200","28250","28300","28350","28400","28450","28500","28550","28600","28650","28700","28750","28800","28850","28900","28950","29000","29050","29100","29150","29200","29250","29300","29350","29400","29450","29500","29550","29600","29650","29700","29750","29800","29850","29900","29950","30000"])

// IMPORTANT (Pine limitation): request.security() requires a simple string symbol.
// So CE/PE symbols must come from input values, not dynamic series values.
ce_strike = manual_ce_strike
pe_strike = manual_pe_strike

symbol_build(_underlying, _expiry, _strike, _optType) =>
    exchange_prefix + _underlying + _expiry + _optType + _strike

ce_symbol = symbol_build(underlying, expiry_code, ce_strike, "C")
pe_symbol = symbol_build(underlying, expiry_code, pe_strike, "P")

straddle_ce_symbol = symbol_build(underlying, expiry_code, straddle_strike, "C")
straddle_pe_symbol = symbol_build(underlying, expiry_code, straddle_strike, "P")

// Load selected strike prices
ce_close = request.security(ce_symbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
pe_close = request.security(pe_symbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

ce_open = request.security(ce_symbol, timeframe.period, open, barmerge.gaps_off, barmerge.lookahead_off)
ce_high = request.security(ce_symbol, timeframe.period, high, barmerge.gaps_off, barmerge.lookahead_off)
ce_low  = request.security(ce_symbol, timeframe.period, low, barmerge.gaps_off, barmerge.lookahead_off)

pe_open = request.security(pe_symbol, timeframe.period, open, barmerge.gaps_off, barmerge.lookahead_off)
pe_high = request.security(pe_symbol, timeframe.period, high, barmerge.gaps_off, barmerge.lookahead_off)
pe_low  = request.security(pe_symbol, timeframe.period, low, barmerge.gaps_off, barmerge.lookahead_off)

// Straddle data (CE + PE)
straddle_ce_close = request.security(straddle_ce_symbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)
straddle_pe_close = request.security(straddle_pe_symbol, timeframe.period, close, barmerge.gaps_off, barmerge.lookahead_off)

straddle_ce_open = request.security(straddle_ce_symbol, timeframe.period, open, barmerge.gaps_off, barmerge.lookahead_off)
straddle_ce_high = request.security(straddle_ce_symbol, timeframe.period, high, barmerge.gaps_off, barmerge.lookahead_off)
straddle_ce_low  = request.security(straddle_ce_symbol, timeframe.period, low, barmerge.gaps_off, barmerge.lookahead_off)

straddle_pe_open = request.security(straddle_pe_symbol, timeframe.period, open, barmerge.gaps_off, barmerge.lookahead_off)
straddle_pe_high = request.security(straddle_pe_symbol, timeframe.period, high, barmerge.gaps_off, barmerge.lookahead_off)
straddle_pe_low  = request.security(straddle_pe_symbol, timeframe.period, low, barmerge.gaps_off, barmerge.lookahead_off)

// Straddle combined OHLC (CE + PE)
straddle_open = straddle_ce_open + straddle_pe_open
straddle_high = straddle_ce_high + straddle_pe_high
straddle_low = straddle_ce_low + straddle_pe_low
straddle_close = straddle_ce_close + straddle_pe_close

show_ce_candles = input.bool(true, "Show CE Candles")
show_pe_candles = input.bool(true, "Show PE Candles")
show_close_lines = input.bool(true, "Show CE/PE Close Lines")

// Volume bar controls
show_volume_bars = input.bool(true, "Show Volume Bars", group="Volume")
vol_height_pct   = input.float(20.0, "Volume Bar Height (%)", minval=5, maxval=50, step=5, group="Volume",
                     tooltip="Volume bars are scaled to this % of the visible price range so they fit neatly at the bottom of the pane.")

// Fetch volume for each strike
ce_volume = request.security(ce_symbol, timeframe.period, volume, barmerge.gaps_off, barmerge.lookahead_off)
pe_volume = request.security(pe_symbol, timeframe.period, volume, barmerge.gaps_off, barmerge.lookahead_off)
straddle_ce_volume = request.security(straddle_ce_symbol, timeframe.period, volume, barmerge.gaps_off, barmerge.lookahead_off)
straddle_pe_volume = request.security(straddle_pe_symbol, timeframe.period, volume, barmerge.gaps_off, barmerge.lookahead_off)
straddle_volume = straddle_ce_volume + straddle_pe_volume


// Scale volume bars to a fraction of the visible price range
// We consider all visible instruments (CE, PE, Straddle) to ensure the baselines match
_hi = ta.highest(math.max(show_ce_candles ? ce_high : 0, math.max(show_pe_candles ? pe_high : 0, show_straddle ? straddle_high : 0)), 100)
_lo = ta.lowest(math.min(show_ce_candles ? ce_low : 1000000, math.min(show_pe_candles ? pe_low : 1000000, show_straddle ? straddle_low : 1000000)), 100)
price_range = _hi - _lo
vol_scale_height = price_range * (vol_height_pct / 100.0)  // max bar height in price units

// Normalise volume: scale relative to rolling 100-bar max volume
max_ce_vol = ta.highest(ce_volume, 100)
max_pe_vol = ta.highest(pe_volume, 100)
max_str_vol = ta.highest(straddle_volume, 100)

// Volume bar base = lowest visible price (bars grow upward from bottom)
vol_base = _lo

// Scaled bar heights (in price units)
ce_vol_bar  = (max_ce_vol  > 0) ? vol_scale_height * (ce_volume  / max_ce_vol)  : 0.0
pe_vol_bar  = (max_pe_vol  > 0) ? vol_scale_height * (pe_volume  / max_pe_vol)  : 0.0
str_vol_bar = (max_str_vol > 0) ? vol_scale_height * (straddle_volume / max_str_vol) : 0.0

// Label controls (similar to Dynamic CPR)
show_labels = input.bool(title="Show Labels", defval=true, group="labels")
show_prices = input.bool(title="Show Prices", defval=false, group="labels")
position_labels = input.string("Right", "Labels Position", options=["Left", "Right"], group="labels")

// Candle label controls
show_candle_labels = input.bool(title="Show Candle Labels", defval=true, group="labels")
show_candle_prices = input.bool(title="Show Candle Prices", defval=true, group="labels")


// Custom Daily VWAP Calculation Function
// This ensures we use the correct volume for each fetched security
f_daily_vwap(src, vol) =>
    var float cum_pv = 0.0
    var float cum_v = 0.0
    if ta.change(time("D"))
        cum_pv := 0.0
        cum_v := 0.0
    
    // Only accumulate if we have valid data
    if not na(src) and not na(vol)
        cum_pv += src * vol
        cum_v += vol
    
    cum_v > 0 ? cum_pv / cum_v : na

// Calculate VWAP for CE and PE strikes using their respective High/Low/Close and Volume
ce_hlc3 = (ce_high + ce_low + ce_close) / 3
pe_hlc3 = (pe_high + pe_low + pe_close) / 3

ce_vwap = f_daily_vwap(ce_hlc3, ce_volume)
pe_vwap = f_daily_vwap(pe_hlc3, pe_volume)

// Calculate VWAP for straddle (CE VWAP + PE VWAP)
// For straddle monitoring, traders typically look at the combined VWAP level
str_ce_hlc3 = (straddle_ce_high + straddle_ce_low + straddle_ce_close) / 3
str_pe_hlc3 = (straddle_pe_high + straddle_pe_low + straddle_pe_close) / 3

straddle_vwap = f_daily_vwap(str_ce_hlc3, straddle_ce_volume) + f_daily_vwap(str_pe_hlc3, straddle_pe_volume)

// Label variables for persistent display (VWAP labels)
var label ce_label = na
var label pe_label = na
var label straddle_label = na

// Label variables for candles
var label ce_candle_label = na
var label pe_candle_label = na
var label straddle_candle_label = na


// Function to create labels with right side positioning
draw_label(y, txt, txt_color) =>
    if show_labels or show_prices
        display_text = ""
        if show_labels and show_prices and txt != ''
            display_text := str.format("{0} - {1}", txt, math.round_to_mintick(y))
        else if show_labels and txt != ''
            display_text := txt
        else
            display_text := str.format("{0}", math.round_to_mintick(y))
        
        // Position VWAP label further away on the right side
        x = bar_index + 25
        label_obj = label.new(x=x, y=y, text="     " + display_text, textcolor=txt_color, style=label.style_none, color=#00000000, size=size.small, xloc=xloc.bar_index)
        label_obj

// Function to create candle labels (positioned on right side like VWAP)
draw_candle_label(y, txt, txt_color) =>
    if show_candle_labels or show_candle_prices
        display_text = ""
        if show_candle_labels and show_candle_prices and txt != ''
            display_text := str.format("{0} - {1}", txt, math.round_to_mintick(y))
        else if show_candle_labels and txt != ''
            display_text := txt
        else
            display_text := str.format("{0}", math.round_to_mintick(y))
        
        // Position label very close to candle
        x = bar_index + 6
        label_obj = label.new(x=x, y=y, text="     " + display_text, textcolor=txt_color, style=label.style_none, color=#00000000, size=size.small, xloc=xloc.bar_index)
        label_obj

// Plot CE candles with conditional coloring
// Green candle: Open < Close (Bullish) - Teal green #1b9981
// Red candle: Open > Close (Bearish) - Vibrant red #f23645
ce_color = ce_close >= ce_open ? color.new(#1b9981, 0) : color.new(#f23645, 0)
plotcandle(
     show_ce_candles ? ce_open : na,
     show_ce_candles ? ce_high : na,
     show_ce_candles ? ce_low : na,
     show_ce_candles ? ce_close : na,
     title="CE Candles",
     color=ce_color,
     wickcolor=ce_color,
     bordercolor=ce_color)

// Plot PE candles with conditional coloring
// Green candle: Open < Close (Bullish) - Blue #1f77d2
// Red candle: Open > Close (Bearish) - Black #000000
pe_color = pe_close >= pe_open ? color.new(#1f77d2, 0) : color.new(#000000, 0)
plotcandle(
     show_pe_candles ? pe_open : na,
     show_pe_candles ? pe_high : na,
     show_pe_candles ? pe_low : na,
     show_pe_candles ? pe_close : na,
     title="PE Candles",
     color=pe_color,
     wickcolor=pe_color,
     bordercolor=pe_color)

plot(show_close_lines ? ce_vwap : na, "CE VWAP", color=color.new(color.green, 0), linewidth=2)
plot(show_close_lines ? pe_vwap : na, "PE VWAP", color=color.new(#808080, 0), linewidth=2)

// Plot Straddle candles with conditional coloring
// Green candle: Open < Close (Bullish) - Violet #9b59b6
// Red candle: Open > Close (Bearish) - Orange #ff9500
straddle_color = straddle_close >= straddle_open ? color.new(#9b59b6, 0) : color.new(#ff9500, 0)
plotcandle(
     show_straddle ? straddle_open : na,
     show_straddle ? straddle_high : na,
     show_straddle ? straddle_low : na,
     show_straddle ? straddle_close : na,
     title="Straddle Candles",
     color=straddle_color,
     wickcolor=straddle_color,
     bordercolor=straddle_color)

// Plot Straddle VWAP
plot(show_straddle ? straddle_vwap : na, "Straddle VWAP", color=color.new(#ffeb3b, 0), linewidth=2)

// ─────────────────────────────────────────────────────────────────────────────
// VOLUME BARS — proper column bars scaled to the candle price range
// Bars grow upward from _lo (bottom of visible candle area)
// Colour follows candle direction: up = bull colour, down = bear colour
// ─────────────────────────────────────────────────────────────────────────────

// Volume MA controls
show_vol_ma = input.bool(true, "Show Volume MA Line", group="Volume")
vol_ma_len  = input.int(20,   "Volume MA Length",    minval=2, maxval=200, step=1, group="Volume")

// Direction colours (match candle palette)
ce_vol_col  = ce_close  >= ce_open  ? color.new(#1b9981, 20) : color.new(#f23645, 20)
pe_vol_col  = pe_close  >= pe_open  ? color.new(#1f77d2, 20) : color.new(#000000, 30)
straddle_close_val = straddle_ce_close + straddle_pe_close
straddle_open_val  = straddle_ce_open  + straddle_pe_open
str_vol_col = straddle_close_val >= straddle_open_val ? color.new(#9b59b6, 20) : color.new(#ff9500, 20)



// Volume MA lines (SMA of raw volume, scaled to price units for overlay)
ce_vol_ma_raw  = ta.sma(ce_volume,       vol_ma_len)
pe_vol_ma_raw  = ta.sma(pe_volume,       vol_ma_len)
str_vol_ma_raw = ta.sma(straddle_volume, vol_ma_len)

ce_vol_ma_scaled  = (max_ce_vol  > 0) ? vol_scale_height * (ce_vol_ma_raw  / max_ce_vol)  : 0.0
pe_vol_ma_scaled  = (max_pe_vol  > 0) ? vol_scale_height * (pe_vol_ma_raw  / max_pe_vol)  : 0.0
str_vol_ma_scaled = (max_str_vol > 0) ? vol_scale_height * (str_vol_ma_raw / max_str_vol) : 0.0

plot(show_volume_bars and show_vol_ma and show_ce_candles ? vol_base + ce_vol_ma_scaled  : na, "CE Vol MA",  color=color.new(#1b9981, 0), linewidth=2)
plot(show_volume_bars and show_vol_ma and show_pe_candles ? vol_base + pe_vol_ma_scaled  : na, "PE Vol MA",  color=color.new(#1f77d2, 0), linewidth=2)
plot(show_volume_bars and show_vol_ma and show_straddle   ? vol_base + str_vol_ma_scaled : na, "STR Vol MA", color=color.new(#9b59b6, 0), linewidth=2)

// Background highlight when volume spikes > 1.5× its own MA (unusual activity)
high_ce_vol = show_volume_bars and show_vol_ma and (ce_volume  > ce_vol_ma_raw  * 1.5)
high_pe_vol = show_volume_bars and show_vol_ma and (pe_volume  > pe_vol_ma_raw  * 1.5)

bgcolor(high_ce_vol and high_pe_vol     ? color.new(color.yellow, 88) : na, title="High Vol — Both CE+PE")
bgcolor(high_ce_vol and not high_pe_vol ? color.new(#1b9981, 92)      : na, title="High Vol — CE only")
bgcolor(high_pe_vol and not high_ce_vol ? color.new(#1f77d2, 92)      : na, title="High Vol — PE only")


// Display labels on right side on last bar
if barstate.islast
    // CE VWAP Label
    if show_close_lines and show_ce_candles
        if not na(ce_label)
            label.delete(ce_label)
        ce_label := draw_label(ce_vwap, "CE VWAP", color.new(color.green, 0))
    else
        if not na(ce_label)
            label.delete(ce_label)
            ce_label := na
    
    // PE VWAP Label
    if show_close_lines and show_pe_candles
        if not na(pe_label)
            label.delete(pe_label)
        pe_label := draw_label(pe_vwap, "PE VWAP", color.new(#808080, 0))
    else
        if not na(pe_label)
            label.delete(pe_label)
            pe_label := na
    
    // Straddle VWAP Label
    if show_straddle
        if not na(straddle_label)
            label.delete(straddle_label)
        straddle_label := draw_label(straddle_vwap, "STR VWAP", color.new(#ffeb3b, 0))
    else
        if not na(straddle_label)
            label.delete(straddle_label)
            straddle_label := na
    
    // CE Candle Label
    if show_ce_candles
        if not na(ce_candle_label)
            label.delete(ce_candle_label)
        ce_candle_label := draw_candle_label(ce_close, "CE", ce_color)
    else
        if not na(ce_candle_label)
            label.delete(ce_candle_label)
            ce_candle_label := na
    
    // PE Candle Label
    if show_pe_candles
        if not na(pe_candle_label)
            label.delete(pe_candle_label)
        pe_candle_label := draw_candle_label(pe_close, "PE", pe_color)
    else
        if not na(pe_candle_label)
            label.delete(pe_candle_label)
            pe_candle_label := na
    
    // Straddle Candle Label
    if show_straddle
        if not na(straddle_candle_label)
            label.delete(straddle_candle_label)
        straddle_candle_label := draw_candle_label(straddle_close, "STR", straddle_color)
    else
        if not na(straddle_candle_label)
            label.delete(straddle_candle_label)
            straddle_candle_label := na



