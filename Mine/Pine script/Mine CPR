//@version=5
indicator("CPR", "Mine CPR", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)
//FLAG
sp = input(true, title="Show CPR")
fsd = input(false, title="Show Future CPR")
shadow = input(true, title="CPR shadow")
cprTransp = input.int(80, "CPR Central Transparency", minval=0, maxval=100)
rsTransp = input.int(98, "CPR R/S Transparency", minval=0, maxval=100)
mcprTransp = input.int(20, "Multi-Pivot Transparency", minval=0, maxval=100)
showPivots  = input.bool(true, title="Multi CPR",  group="Multi CPR")
show15mCPR  = input.bool(false,  title="15 min",    group="Multi CPR", inline="mcpr_tfs")
show30mCPR  = input.bool(false,  title="30 min",    group="Multi CPR", inline="mcpr_tfs")
show1hCPR   = input.bool(true,  title="1 Hour",    group="Multi CPR", inline="mcpr_tfs")
showAllSMAs = input(false, "Show All Moving Averages")
enableIndicator = input.bool(false, "Enable Indicator", group = "Appearance")
showSMA9 = input(true, "Show SMA 9", inline="sma9")
EMA9 = input.int(9, "", inline="sma9")
showSMA20 = input(true, "Show SMA 20", inline="sma20")
EMA20 = input.int(20, "", inline="sma20")
showSMA50 = input(true, "Show SMA 50", inline="sma50")
EMA50 = input.int(50, "", inline="sma50")
showSMA100 = input(false, "Show SMA 100", inline="sma100")
EMA100 = input.int(100, "", inline="sma100")
showSMA200 = input(true, "Show SMA 200", inline="sma200")
EMA200 = input.int(200, "", inline="sma200")

mshortest = ta.ema(close, EMA9)
shortest = ta.ema(close, EMA20)
short = ta.ema(close, EMA50)
longer = ta.ema(close, EMA100)
longest = ta.ema(close, EMA200)

plot(showAllSMAs and showSMA9 ? mshortest : na, color = color.green, linewidth=1, title="SMA 9")
plot(showAllSMAs and showSMA20 ? shortest : na, color = color.orange, linewidth=1, title="SMA 20")
plot(showAllSMAs and showSMA50 ? short : na, color = color.red, linewidth=1, title="SMA 50")
plot(showAllSMAs and showSMA100 ? longer : na, color = color.blue, linewidth=1, title="SMA 100")
plot(showAllSMAs and showSMA200 ? longest : na, color = color.black, linewidth=1, title="SMA 200")

//-----------------------------------------------------------------------------------------------------------------------------------------------------

AUTO = "Auto"
DAILY = "Daily"
WEEKLY = "Weekly"
MONTHLY = "Monthly"
QUARTERLY = "Quarterly"
YEARLY = "Yearly"
BIYEARLY = "Biyearly"
TRIYEARLY = "Triyearly"
QUINQUENNIALLY = "Quinquennially"
DECENNIALLY = "Decennially"

TRADITIONAL = "Traditional"
FIBONACCI = "Fibonacci"
CAMARILLA = "Camarilla"

kind = input.string(title="Type", defval="Camarilla", options=[TRADITIONAL, FIBONACCI, CAMARILLA])
pivot_time_frame = input.string(title="Pivots Timeframe", defval=AUTO, options=[AUTO, DAILY, WEEKLY, MONTHLY, QUARTERLY, YEARLY, BIYEARLY, TRIYEARLY, QUINQUENNIALLY, DECENNIALLY])
look_back = input.int(title="Number of Pivots Back", defval=15, minval=1, maxval=5000, tooltip="Pine Script allows max 500 line objects. Each pivot uses ~15 lines by default (~33 pivots max). Enable 'CPR Only in History' for ~160 pivots, or disable R/S and PDH/PDL toggles for ~50 pivots.")
hist_cpr_only  = input.bool(false, "Historical CPR Lines Only (allows more pivots back)", tooltip="When ON, only P/BC/TC are drawn for historical pivots (~160 pivots max). When OFF, all R/S/PDH/PDL lines are drawn (~33 pivots max).")
show_resistance = input.bool(false, "Show R1-R3", inline="show_rs")
show_support    = input.bool(false, "Show S1-S3", inline="show_rs")
hist_show_pdhl  = input.bool(false, "Show PDH/PDL in History", tooltip="Disable to save 2 lines per pivot.")
is_daily_based = input.bool(title="Use Daily-based Values", defval=true, tooltip="When this option is unchecked, Pivot Points will use intraday data while calculating on intraday charts. If Extended Hours are displayed on the chart, they will be taken into account during the pivot level calculation. If intraday OHLC values are different from daily-based values (normal for stocks), the pivot levels will also differ.")
show_labels = input.bool(title="Show Labels", defval=false, inline="labels")
position_labels = input.string("Left", "", options=["Left", "Right"], inline="labels")

// Virgin CPR — a CPR whose BC/TC band was never touched by price during the
// session it belongs to. Untested levels stay live support/resistance, so they
// get their own shadow colour and are carried forward until a candle hits them.
vcpr_show    = input.bool(true, "Highlight Virgin CPR", group="Virgin CPR", tooltip="A CPR is virgin when no candle traded into its BC-TC band during its own session. Only the shadow changes colour; the lines keep the normal CPR look.")
vcpr_extend  = input.bool(true, "Extend until touched", group="Virgin CPR", tooltip="Virgin CPRs are extended to the right and stop at the end of the session in which price first touches the band. Still-untouched ones run to the right edge of the chart, into the future.")
vcpr_fill    = input.color(#FFF59D, "Virgin CPR Shadow Colour", group="Virgin CPR")
vcpr_transp  = input.int(60, "Virgin CPR Shadow Transparency", minval=0, maxval=100, group="Virgin CPR")

var DEF_COLOR = #FB8C00
var R3S3_COLOR = #A020F0
var P_COLOR = #8E2929
var arr_time = array.new_int()
var p = array.new_float()
p_show = input.bool(false, "P‏  ‏  ‏  ‏  ‏  ‏  ‏  ‏", inline="P")
p_color = input.color(P_COLOR, "", inline="P")
var r3 = array.new_float()
var s3 = array.new_float()
s3r3_show  = input.bool(true, "Show R3/S3", inline="S3/R3")
s3r3_color = input.color(R3S3_COLOR, "", inline="S3/R3")

// CPR Arrays
var arr_p = array.new_float()
var arr_bc = array.new_float()
var arr_tc = array.new_float()
var arr_r1 = array.new_float()
var arr_r2 = array.new_float()
var arr_s1 = array.new_float()
var arr_s2 = array.new_float()
var arr_pdh = array.new_float()
var arr_pdl = array.new_float()
// Virgin CPR state, one entry per pivot, kept in step with the arrays above
var arr_virgin = array.new_bool()   // true while the band was never touched in its own session
var arr_vtouch = array.new_int()    // close time of the session in which it is first touched afterwards

pivotX_open = float(na)
pivotX_open := nz(pivotX_open[1], open)
pivotX_high = float(na)
pivotX_high := nz(pivotX_high[1], high)
pivotX_low = float(na)
pivotX_low := nz(pivotX_low[1], low)
pivotX_prev_open = float(na)
pivotX_prev_open := nz(pivotX_prev_open[1])
pivotX_prev_high = float(na)
pivotX_prev_high := nz(pivotX_prev_high[1])
pivotX_prev_low = float(na)
pivotX_prev_low := nz(pivotX_prev_low[1])
pivotX_prev_close = float(na)
pivotX_prev_close := nz(pivotX_prev_close[1])

// Color and Timeframe Definitions for CPR
greenColor = #00cc66
darkgreenColor = #006400
redColor = #ff0000
pivtcol = #00008B
pivotColor = #3366ff
timeframe = timeframe.isweekly or timeframe.ismonthly ? "12M" : timeframe.isdaily ? "M" : timeframe.multiplier <= 15 ? "D" : "W"
prevHighColor = #ef07f9

get_pivot_resolution() =>
    resolution = "M"
    if pivot_time_frame == AUTO
        if timeframe.isintraday
            resolution := timeframe.multiplier <= 15 ? "D" : "W"
        else if timeframe.isweekly or timeframe.ismonthly
            resolution := "12M"
    else if pivot_time_frame == DAILY
        resolution := "D"
    else if pivot_time_frame == WEEKLY
        resolution := "W"
    else if pivot_time_frame == MONTHLY
        resolution := "M"
    else if pivot_time_frame == QUARTERLY
        resolution := "3M"
    else if pivot_time_frame == YEARLY or pivot_time_frame == BIYEARLY or pivot_time_frame == TRIYEARLY or pivot_time_frame == QUINQUENNIALLY or pivot_time_frame == DECENNIALLY
        resolution := "12M"
    resolution

var lines = array.new_line()
var fills = array.new_linefill()
var labels = array.new_label()

draw_line(i, pivot, col) =>
    if array.size(arr_time) > 1
        array.push(lines, line.new(array.get(arr_time, i), array.get(pivot, i), array.get(arr_time, i + 1), array.get(pivot, i), color=col, xloc=xloc.bar_time, width=2))

draw_label(i, y, txt, txt_color) =>
    if show_labels
        offset = '‏  ‏  ‏  ‏  ‏'
        labels_align_str_left= position_labels == "Left" ? txt + offset : offset + txt
        x = position_labels == "Left" ? array.get(arr_time, i) : array.get(arr_time, i + 1)
        array.push(labels, label.new(x = x, y=y, text=labels_align_str_left, textcolor=txt_color, style=label.style_label_center, color=#00000000, xloc=xloc.bar_time))

camarilla() =>
    pivotX_Median = (pivotX_prev_high + pivotX_prev_low + pivotX_prev_close) / 3
    pivot_range = pivotX_prev_high - pivotX_prev_low
    array.push(p, pivotX_Median)
    array.push(r3, pivotX_prev_close + pivot_range * 1.1 / 4.0)
    array.push(s3, pivotX_prev_close - pivot_range * 1.1 / 4.0)

resolution = get_pivot_resolution()

[sec_open, sec_high, sec_low, sec_close] = request.security(syminfo.tickerid, resolution, [open, high, low, close], lookahead = barmerge.lookahead_on)
sec_open_gaps_on = request.security(syminfo.tickerid, resolution, open, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on)

custom_years_divisor = switch pivot_time_frame
	BIYEARLY => 2
	TRIYEARLY => 3
	QUINQUENNIALLY => 5
	DECENNIALLY => 10
	=> -1

is_change_years = false	
if custom_years_divisor > 0 and ta.change(time(resolution))
	is_change_years := year % custom_years_divisor == 0

var is_change = false
var uses_current_bar = timeframe.isintraday
var change_time = int(na)
is_time_change = (ta.change(time(resolution)) and custom_years_divisor == -1) or is_change_years
if is_time_change
    change_time := time


if (not uses_current_bar and is_time_change) or (uses_current_bar and not na(sec_open_gaps_on))
    if is_daily_based and custom_years_divisor == -1
        pivotX_prev_open := sec_open[1]
        pivotX_prev_high := sec_high[1]
        pivotX_prev_low := sec_low[1]
        pivotX_prev_close := sec_close[1]
        pivotX_open := sec_open
        pivotX_high := sec_high
        pivotX_low := sec_low
    else
        pivotX_prev_high := pivotX_high
        pivotX_prev_low := pivotX_low
        pivotX_prev_open := pivotX_open
        pivotX_open := open
        pivotX_high := high
        pivotX_low := low
        pivotX_prev_close := close[1]

    if barstate.islast and not is_change and  array.size(arr_time) > 0
        array.set(arr_time, array.size(arr_time) - 1, change_time)
    else
        array.push(arr_time, change_time)

    if kind == CAMARILLA
        camarilla()

    // CPR Calculation for Arrays
    _pivot = (pivotX_prev_high + pivotX_prev_low + pivotX_prev_close) / 3.0
    _bc = (pivotX_prev_high + pivotX_prev_low) / 2.0
    _tc = (_pivot - _bc) + _pivot
    array.push(arr_p, _pivot)
    array.push(arr_bc, _bc)
    array.push(arr_tc, _tc)
    array.push(arr_r1, (_pivot * 2) - pivotX_prev_low)
    array.push(arr_r2, _pivot + (pivotX_prev_high - pivotX_prev_low))
    array.push(arr_s1, (_pivot * 2) - pivotX_prev_high)
    array.push(arr_s2, _pivot - (pivotX_prev_high - pivotX_prev_low))
    array.push(arr_pdh, pivotX_prev_high)
    array.push(arr_pdl, pivotX_prev_low)
    array.push(arr_virgin, true)
    array.push(arr_vtouch, int(na))

    if array.size(arr_time) > look_back
        if array.size(arr_time) > 0
            array.shift(arr_time)
        if array.size(p) > 0 and p_show
            array.shift(p)
        if array.size(r3) > 0 and s3r3_show
            array.shift(r3)
        if array.size(s3) > 0 and s3r3_show
            array.shift(s3)
        // Shift CPR Arrays
        if array.size(arr_p) > 0
            array.shift(arr_p), array.shift(arr_bc), array.shift(arr_tc)
            array.shift(arr_r1), array.shift(arr_r2)
            array.shift(arr_s1), array.shift(arr_s2)
            array.shift(arr_pdh), array.shift(arr_pdl)
            array.shift(arr_virgin), array.shift(arr_vtouch)
    is_change := true
else
    if is_daily_based and custom_years_divisor == -1
        pivotX_high := math.max(pivotX_high, sec_high)
        pivotX_low := math.min(pivotX_low, sec_low)
    else
        pivotX_high := math.max(pivotX_high, high)
        pivotX_low := math.min(pivotX_low, low)

// Virgin CPR tracking — runs on every bar. The newest CPR loses its virginity
// the moment price trades into its band; older virgin CPRs remember the END of
// the session in which a candle finally reaches them, and stop extending there.
pivot_period_close = time_close(resolution)
if sp and (vcpr_show or vcpr_extend) and array.size(arr_p) > 0
    _cur = array.size(arr_p) - 1
    for i = 0 to _cur
        _band_lo = math.min(array.get(arr_bc, i), array.get(arr_tc, i))
        _band_hi = math.max(array.get(arr_bc, i), array.get(arr_tc, i))
        _hit = high >= _band_lo and low <= _band_hi
        if _hit and i == _cur
            array.set(arr_virgin, i, false)
        else if _hit and i < _cur and array.get(arr_virgin, i) and na(array.get(arr_vtouch, i))
            array.set(arr_vtouch, i, nz(pivot_period_close, time))

if barstate.islast and array.size(arr_time) > 0 and is_change
    is_change := false
    if array.size(arr_time) > 2 and custom_years_divisor > 0
        last_pivot_time = array.get(arr_time, array.size(arr_time) - 1)
        prev_pivot_time = array.get(arr_time, array.size(arr_time) - 2)
        estimate_pivot_time = last_pivot_time - prev_pivot_time
        array.push(arr_time, last_pivot_time + estimate_pivot_time)
    else
        array.push(arr_time, time_close(resolution))

    for i = 0 to array.size(lines) - 1
        if array.size(lines) > 0
            line.delete(array.shift(lines))
    
    for i = 0 to array.size(fills) - 1
        if array.size(fills) > 0
            linefill.delete(array.shift(fills))

    for i = 0 to array.size(labels) - 1
        if array.size(labels) > 0
            label.delete(array.shift(labels))

    for i = 0 to array.size(arr_time) - 2
        if array.size(p) > 0 and p_show
            draw_line(i, p, p_color)
            draw_label(i, array.get(p, i), "P", p_color)
        // Draw CPR Lines
        if sp and array.size(arr_p) > i
            // The running session is still forming, so it is never styled virgin yet
            _is_live = i == array.size(arr_p) - 1
            // Lines keep the normal CPR colour/style — only the shadow marks a virgin CPR
            _virgin = vcpr_show and not _is_live and array.get(arr_virgin, i)
            _x1 = array.get(arr_time, i)
            _x2 = array.get(arr_time, i + 1)
            _ext = extend.none
            if _virgin and vcpr_extend
                _vt = array.get(arr_vtouch, i)
                if na(_vt)
                    _ext := extend.right          // never touched — carry it into the future
                else if _vt > _x2
                    _x2 := _vt                    // stop at the end of the touch day
            _lp = line.new(_x1, array.get(arr_p, i), _x2, array.get(arr_p, i), xloc=xloc.bar_time, color=pivtcol, width=1, extend=_ext)
            _lbc = line.new(_x1, array.get(arr_bc, i), _x2, array.get(arr_bc, i), xloc=xloc.bar_time, color=pivtcol, width=1, extend=_ext)
            _ltc = line.new(_x1, array.get(arr_tc, i), _x2, array.get(arr_tc, i), xloc=xloc.bar_time, color=pivtcol, width=1, extend=_ext)
            array.push(lines, _lp), array.push(lines, _lbc), array.push(lines, _ltc)
            if shadow
                array.push(fills, linefill.new(_lbc, _ltc, _virgin ? color.new(vcpr_fill, vcpr_transp) : color.new(pivotColor, cprTransp)))

            if not hist_cpr_only and show_resistance and kind == TRADITIONAL
                _lr1 = line.new(array.get(arr_time, i), array.get(arr_r1, i), array.get(arr_time, i+1), array.get(arr_r1, i), xloc=xloc.bar_time, color=darkgreenColor, width=1)
                _lr2 = line.new(array.get(arr_time, i), array.get(arr_r2, i), array.get(arr_time, i+1), array.get(arr_r2, i), xloc=xloc.bar_time, color=darkgreenColor, width=1)
                array.push(lines, _lr1), array.push(lines, _lr2)
                if shadow
                    array.push(fills, linefill.new(_lr1, _lr2, color.new(greenColor, rsTransp)))

            if not hist_cpr_only and show_support and kind == TRADITIONAL
                _ls1 = line.new(array.get(arr_time, i), array.get(arr_s1, i), array.get(arr_time, i+1), array.get(arr_s1, i), xloc=xloc.bar_time, color=redColor, width=1)
                _ls2 = line.new(array.get(arr_time, i), array.get(arr_s2, i), array.get(arr_time, i+1), array.get(arr_s2, i), xloc=xloc.bar_time, color=redColor, width=1)
                array.push(lines, _ls1), array.push(lines, _ls2)
                if shadow
                    array.push(fills, linefill.new(_ls1, _ls2, color.new(redColor, rsTransp)))

            if not hist_cpr_only and s3r3_show
                if array.size(r3) > i
                    _lr3 = line.new(array.get(arr_time, i), array.get(r3, i), array.get(arr_time, i+1), array.get(r3, i), xloc=xloc.bar_time, color=s3r3_color, width=2)
                    array.push(lines, _lr3)
                    draw_label(i, array.get(r3, i), "R3", s3r3_color)
                if array.size(s3) > i
                    _ls3 = line.new(array.get(arr_time, i), array.get(s3, i), array.get(arr_time, i+1), array.get(s3, i), xloc=xloc.bar_time, color=s3r3_color, width=2)
                    array.push(lines, _ls3)
                    draw_label(i, array.get(s3, i), "S3", s3r3_color)

            if not hist_cpr_only and hist_show_pdhl
                _lpdh = line.new(array.get(arr_time, i), array.get(arr_pdh, i), array.get(arr_time, i+1), array.get(arr_pdh, i), xloc=xloc.bar_time, color=color.new(prevHighColor, 10), width=1)
                _lpdl = line.new(array.get(arr_time, i), array.get(arr_pdl, i), array.get(arr_time, i+1), array.get(arr_pdl, i), xloc=xloc.bar_time, color=color.new(prevHighColor, 10), width=1)
                array.push(lines, _lpdh), array.push(lines, _lpdl)
            
//---------------------------------------------------------------------------------------------------------------------------------------------------------
// Previous High/Low (Kept as plots for now or moved to lines)

// Previous High/Low (Kept as plots for now or moved to lines)
is_new_session = ta.change(time(timeframe))

// Pivot Range Calculations - Mark Fisher
pivot = (high + low + close ) / 3.0 
bc = (high + low ) / 2.0 
tc = (pivot - bc) + pivot
rr1 = (pivot * 2) - low
ss1 = (pivot * 2) - high
rr2 = pivot + (high - low)
ss2 = pivot - (high - low)
rr3 = rr1 + (high - low)
ss3 = ss1 - (high - low)


// Future CPR - Projected into the next session
[ftime_pivot, ftime_bc, ftime_tc, ftime_r1, ftime_r2, _, ftime_s1, ftime_s2, _] = request.security(syminfo.tickerid, timeframe, [pivot[0], bc[0], tc[0], rr1[0], rr2[0], rr3[0], ss1[0], ss2[0], ss3[0]], lookahead=barmerge.lookahead_on)
ftime_pdh = request.security(syminfo.tickerid, timeframe, high[0], lookahead=barmerge.lookahead_on)
ftime_pdl = request.security(syminfo.tickerid, timeframe, low[0], lookahead=barmerge.lookahead_on)

ftime_close = request.security(syminfo.tickerid, timeframe, close[0], lookahead=barmerge.lookahead_on)

var line f_p = na, var line f_bc = na, var line f_tc = na
var line f_r1 = na, var line f_r2 = na
var line f_s1 = na, var line f_s2 = na
var line f_pdh = na, var line f_pdl = na
var line f_cam_r3 = na, var line f_cam_s3 = na

var linefill f_fill_c = na
var linefill f_fill_r12 = na
var linefill f_fill_s12 = na

if barstate.islast and fsd
    line.delete(f_p), line.delete(f_bc), line.delete(f_tc)
    line.delete(f_r1), line.delete(f_r2)
    line.delete(f_s1), line.delete(f_s2)
    line.delete(f_pdh), line.delete(f_pdl)
    line.delete(f_cam_r3), line.delete(f_cam_s3)
    
    // Determine the start and end of the next session
    next_start = time_close(timeframe)
    next_end = next_start
    if timeframe == "D"
        ONE_DAY = 86400000 // 24 hours in ms
        next_end := next_start + ONE_DAY
        // Skip Saturday and Sunday
        while dayofweek(next_end) == dayofweek.saturday or dayofweek(next_end) == dayofweek.sunday
            next_end := next_end + ONE_DAY
    else
        session_duration = next_start - time(timeframe)
        next_end := next_start + session_duration
    
    // Draw lines
    f_p := line.new(next_start, ftime_pivot, next_end, ftime_pivot, xloc=xloc.bar_time, color=pivtcol, width=1, style=line.style_dashed)
    f_bc := line.new(next_start, ftime_bc, next_end, ftime_bc, xloc=xloc.bar_time, color=pivtcol, width=1, style=line.style_dashed)
    f_tc := line.new(next_start, ftime_tc, next_end, ftime_tc, xloc=xloc.bar_time, color=pivtcol, width=1, style=line.style_dashed)
    
    _f_range = ftime_pdh - ftime_pdl

    if show_resistance and kind == TRADITIONAL
        f_r1 := line.new(next_start, ftime_r1, next_end, ftime_r1, xloc=xloc.bar_time, color=darkgreenColor, width=1, style=line.style_dashed)
        f_r2 := line.new(next_start, ftime_r2, next_end, ftime_r2, xloc=xloc.bar_time, color=darkgreenColor, width=1, style=line.style_dashed)

    if show_support and kind == TRADITIONAL
        f_s1 := line.new(next_start, ftime_s1, next_end, ftime_s1, xloc=xloc.bar_time, color=redColor, width=1, style=line.style_dashed)
        f_s2 := line.new(next_start, ftime_s2, next_end, ftime_s2, xloc=xloc.bar_time, color=redColor, width=1, style=line.style_dashed)

    if s3r3_show and kind == CAMARILLA
        f_cam_r3 := line.new(next_start, ftime_close + _f_range * 1.1 / 4.0, next_end, ftime_close + _f_range * 1.1 / 4.0, xloc=xloc.bar_time, color=s3r3_color, width=2, style=line.style_dashed)
