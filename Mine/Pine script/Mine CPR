// ─── EMA Retest Signal ─────────────────────────────────────────────────────────
// Logic:
//   1. Price drops below ALL 3 EMAs
//   2. Price breaks above ALL 3 EMAs
//   3. Price rallies — must stay above all 3 for ≥ minBarsAbove bars AND reach
//      at least rallyATRMult × ATR above the top EMA (stops oscillation signals)
//   4. Price pulls back — low touches EMA band, EMAs are tightly clustered
//   5. First bullish candle in that zone = BUY. Exit: close below 50 EMA.
showEMASignal  = input.bool(false,  "Show EMA Retest Signal",       group = "EMA Signal")
clusterATRMult = input.float(0.3,  "EMA Cluster Threshold (ATR×)", group = "EMA Signal", minval = 0.05, step = 0.05, tooltip = "Max spread between the 3 EMAs as a multiple of ATR(14). Lower = tighter cluster required.")
minBarsAbove   = input.int(3,      "Min Rally Bars",               group = "EMA Signal", minval = 1, maxval = 30,  tooltip = "Minimum bars price must close above ALL 3 EMAs after the breakout before a retest signal can fire.")
rallyATRMult   = input.float(1.0,  "Min Rally Distance (ATR×)",    group = "EMA Signal", minval = 0.1, step = 0.1, tooltip = "Price must reach at least this many ATRs ABOVE the highest EMA during the rally. This is the key filter — it rejects signals where price merely oscillates through the EMAs without a real move away.")
targetPoints   = input.float(25.0, "Target Points",                group = "EMA Signal", minval = 1)

ema9v  = mshortest
ema20v = shortest
ema50v = short

emaTop    = math.max(ema9v, math.max(ema20v, ema50v))
emaBot    = math.min(ema9v, math.min(ema20v, ema50v))
emasClose = (emaTop - emaBot) <= ta.atr(14) * clusterATRMult

aboveAll = close > ema9v  and close > ema20v and close > ema50v
belowAll = close < ema9v  and close < ema20v and close < ema50v

var bool  hadBelowPhase       = false
var bool  setupActive         = false
var bool  wasInRetest         = false
var bool  inTrade             = false
var int   barsAboveAfterBreak = 0
var float maxDistAboveEMAs    = 0.0

// Phase 1 – price drops below all 3 EMAs
if belowAll
    hadBelowPhase := true

// Phase 2 – breakout: first bar price closes above all 3 EMAs after the below phase
if hadBelowPhase and aboveAll and not aboveAll[1]
    setupActive         := true
    hadBelowPhase       := false
    barsAboveAfterBreak := 0
    maxDistAboveEMAs    := 0.0

// Phase 3 – during rally, count bars above all EMAs and track max distance above EMA top
if setupActive and aboveAll
    barsAboveAfterBreak += 1
    dist = close - emaTop
    if dist > maxDistAboveEMAs
        maxDistAboveEMAs := dist

// Rally confirmed only when BOTH thresholds are met:
//   • enough bars above all EMAs (rules out single-bar spikes)
//   • price got meaningfully above the EMA cluster (rules out oscillations)
hadRallyConfirmed = barsAboveAfterBreak >= minBarsAbove and maxDistAboveEMAs >= ta.atr(14) * rallyATRMult

// Phase 4 – retest: low touches EMA band, close stays above 50 EMA
inRetest  = setupActive and hadRallyConfirmed and low <= emaTop and close > ema50v

// Entry: first bullish candle entering the retest zone with clustered EMAs
buySignal = showEMASignal and inRetest and emasClose and close > open and not wasInRetest

// Exit and target only fire if a BUY was previously triggered
exitSignal = showEMASignal and inTrade and close < ema50v

wasInRetest := inRetest

// Set inTrade on entry, clear on exit
if buySignal
    inTrade := true
if close < ema50v
    inTrade             := false
    setupActive         := false
    wasInRetest         := false
    barsAboveAfterBreak := 0
    maxDistAboveEMAs    := 0.0

plotshape(buySignal,  "EMA Retest Buy",  shape.triangleup,   location.belowbar, color.new(color.lime, 0), size = size.small, text = "B")
plotshape(exitSignal, "EMA Retest Exit", shape.triangledown, location.abovebar, color.new(color.red,  0), size = size.small, text = "X")

// Target label only on entry
if buySignal
    label.new(bar_index, close + targetPoints, "T " + str.tostring(math.round(close + targetPoints, 2)), color = color.new(color.green, 80), textcolor = color.green, style = label.style_label_down, size = size.tiny)

alertcondition(buySignal,  "EMA Retest Buy Signal",  "EMA Retest Buy — Rally confirmed, clustered EMA retest")
alertcondition(exitSignal, "EMA Retest Exit Signal", "EMA Exit — Close below 50 EMA")

