// ─── 2nd 5-min Candle Box ─────────────────────────────────────────────────────
show2ndCandleBox = input.bool(false, "Show 2nd 5-min Candle Box",   group = "2nd 5-min Candle")
box2FillColor    = input.color(color.new(#00D2FF, 90), "Fill Color",   group = "2nd 5-min Candle")
box2BorderColor  = input.color(#00D2FF, "Border Color", group = "2nd 5-min Candle")

// Only visible on 5-min and below timeframes
is_5min_or_below = timeframe.isintraday and timeframe.multiplier <= 5

// Fetch second 5-min candle data (5-min context)
m5_is_2nd = request.security(syminfo.tickerid, "5", ta.barssince(ta.change(time("D"))) == 1, lookahead = barmerge.lookahead_off)
m5_high2  = request.security(syminfo.tickerid, "5", high, lookahead = barmerge.lookahead_off)
m5_low2   = request.security(syminfo.tickerid, "5", low,  lookahead = barmerge.lookahead_off)
m5_time2  = request.security(syminfo.tickerid, "5", time, lookahead = barmerge.lookahead_off)

var box[] boxes2nd    = array.new_box()
var int   last2ndTime = na

if show2ndCandleBox and is_5min_or_below and m5_is_2nd
    if na(last2ndTime) or last2ndTime != m5_time2
        // New day's second 5-min candle — box extends to end of day
        b = box.new(m5_time2, m5_high2, time_close("D"), m5_low2, border_color = box2BorderColor, bgcolor = box2FillColor, xloc = xloc.bar_time)
        array.push(boxes2nd, b)
        last2ndTime := m5_time2
    else if array.size(boxes2nd) > 0
        // Live update while the candle is forming
        b = array.last(boxes2nd)
        box.set_top(b, m5_high2)
        box.set_bottom(b, m5_low2)

// ─── 2nd 1-Min Candle Box ─────────────────────────────────────────────────────
show2nd1mBox     = input.bool(false, "Show 2nd 1-Min Candle Box", group = "2nd 1-Min Candle")
box1mFillColor   = input.color(color.new(#FF6B6B, 90), "Fill Color",   group = "2nd 1-Min Candle")
box1mBorderColor = input.color(#FF6B6B, "Border Color", group = "2nd 1-Min Candle")

// Only visible on 1-min and below timeframes
is_1m_or_below = timeframe.isintraday and timeframe.multiplier <= 1

// Fetch second 1-min candle data (1-min context)
m1_is_2nd = request.security(syminfo.tickerid, "1", ta.barssince(ta.change(time("D"))) == 1, lookahead = barmerge.lookahead_off)
m1_high2  = request.security(syminfo.tickerid, "1", high, lookahead = barmerge.lookahead_off)
