if show2nd1mBox and is_1m_or_below and m1_is_2nd
    if na(last1mTime) or last1mTime != m1_time2
        // New day's second 1-min candle — box extends to end of day
        b = box.new(m1_time2, m1_high2, time_close("D"), m1_low2, border_color = box1mBorderColor, bgcolor = box1mFillColor, xloc = xloc.bar_time)
        array.push(boxes1m, b)
        last1mTime := m1_time2
    else if array.size(boxes1m) > 0
        // Live update while the candle is forming
        b = array.last(boxes1m)
        box.set_top(b, m1_high2)
        box.set_bottom(b, m1_low2)

// ─── Monday High/Low Box ─────────────────────────────────────────────────────
show_monday_box     = input.bool(true, "Show Monday H/L Box",  group = "Monday Box")
monday_weeks_back   = input.int(100,  "Weeks Back", minval=1, maxval=500, group = "Monday Box")
monday_fill_color   = input.color(color.new(#FFD700, 100), "Fill Color",   group = "Monday Box")
monday_border_color = input.color(color.new(#000000, 0),  "Border Color", group = "Monday Box")
monday_line_width   = input.int(2, "Border Width", minval=1, maxval=4, group = "Monday Box")

var float mon_high    = na
var float mon_low     = na
var box   cur_mon_box = na
var box[] mon_boxes   = array.new_box()

is_monday           = dayofweek == dayofweek.monday
is_first_monday_bar = ta.change(time("D")) != 0 and is_monday

// Only visible on 1-hour and below timeframes
is_1h_or_below = timeframe.isintraday and (timeframe.isseconds or timeframe.multiplier <= 60)

if show_monday_box and is_1h_or_below
    if is_first_monday_bar
        mon_high    := high
        mon_low     := low
        cur_mon_box := box.new(time, high, time_close("W"), low,
                               border_color = monday_border_color,
                               bgcolor      = monday_fill_color,
                               border_width = monday_line_width,
                               xloc         = xloc.bar_time)
        array.push(mon_boxes, cur_mon_box)
        if array.size(mon_boxes) > monday_weeks_back
            box.delete(array.shift(mon_boxes))

    else if is_monday and not na(cur_mon_box)
        mon_high := math.max(mon_high, high)
        mon_low  := math.min(mon_low, low)
        box.set_top(cur_mon_box, mon_high)
        box.set_bottom(cur_mon_box, mon_low)

// ─── Current & Previous VWAP ─────────────────────────────────────────────────
vwap_showCurrent  = input.bool(true, "Current VWAP",  group="VWAP Style", inline="vwap_cur")
vwap_colCurrent   = input.color(color.new(color.blue,   0), "", group="VWAP Style", inline="vwap_cur")
vwap_showPrevious = input.bool(true, "Previous VWAP", group="VWAP Style", inline="vwap_prev")
vwap_colPrevious  = input.color(color.new(color.orange, 0), "", group="VWAP Style", inline="vwap_prev")
vwap_showAvg3     = input.bool(true, "Avg 3 VWAP",    group="VWAP Style", inline="vwap_avg3")
vwap_colAvg3      = input.color(color.new(color.red,    0), "", group="VWAP Style", inline="vwap_avg3")
vwap_lineWidth   = input.int(2, "Line Width", minval=1, maxval=4,            group="VWAP Style")
vwap_showLabels  = input.bool(false, "Show VWAP Price Labels",            group="VWAP Style")

// Only visible on 15-min and below
vwap_show = timeframe.isintraday and timeframe.multiplier <= 15

// Session detection and VWAP calculation
vwap_isNewSession = ta.change(time("D")) != 0
vwap_typicalPrice = (high + low + close) / 3.0

var float vwap_cumPV     = 0.0
var float vwap_cumVol    = 0.0
var float vwap_prevVWAP  = na  // last completed session's closing VWAP
var float vwap_prevVWAP2 = na  // 2 sessions ago
var float vwap_prevVWAP3 = na  // 3 sessions ago

if vwap_isNewSession
    // Shift oldest-first so today's newly-completed VWAP lands in vwap_prevVWAP
    // without clobbering the values it's about to push down the chain.
    vwap_prevVWAP3 := vwap_prevVWAP2
    vwap_prevVWAP2 := vwap_prevVWAP
    vwap_prevVWAP  := vwap_cumPV / vwap_cumVol
    vwap_cumPV     := vwap_typicalPrice * volume
    vwap_cumVol    := volume
else
    vwap_cumPV  += vwap_typicalPrice * volume
    vwap_cumVol += volume

vwap_currentVWAP = vwap_cumPV / vwap_cumVol

// Average of the last 3 COMPLETED sessions' closing VWAP (excludes today's
// still-forming current VWAP so the line only steps once per day, like
// Previous VWAP does).
vwap_avg3 = (not na(vwap_prevVWAP) and not na(vwap_prevVWAP2) and not na(vwap_prevVWAP3)) ? (vwap_prevVWAP + vwap_prevVWAP2 + vwap_prevVWAP3) / 3.0 : na

plot(vwap_show and vwap_showCurrent  ? vwap_currentVWAP : na, title="Current VWAP",  color=vwap_colCurrent,  linewidth=vwap_lineWidth)
plot(vwap_show and vwap_showPrevious ? vwap_prevVWAP    : na, title="Previous VWAP", color=vwap_colPrevious, linewidth=vwap_lineWidth)
plot(vwap_show and vwap_showAvg3     ? vwap_avg3        : na, title="Avg 3 VWAP",    color=vwap_colAvg3,     linewidth=vwap_lineWidth)

if barstate.islast and vwap_show and vwap_showLabels
    if vwap_showCurrent
        label.new(bar_index, vwap_currentVWAP, text="VWAP\n" + str.tostring(vwap_currentVWAP, "#.##"), color=vwap_colCurrent,  textcolor=color.white, style=label.style_label_left, size=size.small)
    if vwap_showAvg3 and not na(vwap_avg3)
        label.new(bar_index, vwap_avg3, text="Avg 3 VWAP\n" + str.tostring(vwap_avg3, "#.##"), color=vwap_colAvg3, textcolor=color.white, style=label.style_label_left, size=size.small)
    if vwap_showPrevious and not na(vwap_prevVWAP)
        label.new(bar_index, vwap_prevVWAP, text="Prev VWAP\n" + str.tostring(vwap_prevVWAP, "#.##"), color=vwap_colPrevious, textcolor=color.white, style=label.style_label_left, size=size.small)