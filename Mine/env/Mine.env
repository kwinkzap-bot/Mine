# ── RTP Railway Track Algo ────────────────────────────────────────────────────
# Global kill-switch per timeframe variant (gates signal detection / order placement).
# Per-broker participation is controlled by BROKER_{N}_RTP[_30S|_2M|_3M|_5M]_ACTIVE above.
EMA_RTP_1M_ACTIVE=true
EMA_RTP_30S_ACTIVE=true
EMA_RTP_2M_ACTIVE=true
EMA_RTP_3M_ACTIVE=true
EMA_RTP_5M_ACTIVE=true

# ── 2nd 30-Sec Candle Algo ────────────────────────────────────────────────────
SC_ALGO_ACTIVE=true
RTP_1M_STRIKE_MODE=premium250

