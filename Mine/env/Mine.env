# ── RTP Railway Track Algo ────────────────────────────────────────────────────
# Global kill-switch per timeframe variant (gates signal detection / order placement).
# Per-broker participation is controlled by BROKER_{N}_RTP[_30S|_2M|_3M|_5M]_ACTIVE above.
EMA_RTP_1M_ACTIVE=true
EMA_RTP_30S_ACTIVE=true
EMA_RTP_2M_ACTIVE=true
EMA_RTP_3M_ACTIVE=true
EMA_RTP_5M_ACTIVE=false

#---------------------------------------------------------------------------------------------------------------------------------------------

# ── 2nd 30-Sec Candle Algo ────────────────────────────────────────────────────
SC_ALGO_ACTIVE=true
RTP_1M_STRIKE_MODE=premium250

#--- 30-Min ----------------------------------------------------------------------------------------------------------------------------------

# ── 30-Min Opening Fakeout Algo ───────────────────────────────────────────────
# Global kill-switch (gates real order placement only — the monitor thread
# always scans and logs signals regardless). Per-broker participation is
# BROKER_{N}_TMF_ACTIVE below (only broker type=zerodha is wired up so far).
# Both default off on purpose — flip to true only once you've watched a live
# day run with orders disabled and are ready for it to place real orders.
TMF_ALGO_ACTIVE=true
# Start/Stop button state (persisted). true = run every trading day on its
# own; false = the Stop button was clicked, so the 9:15 job and the watchdog
# leave the thread down until Start is clicked again. Missing means true.
TMF_ALGO_ENABLED=true
TMF_CAPITAL_PER_TRADE=100000
TMF_EXIT_HOUR=15
# 15:05, not the backtest's 15:18. Zerodha rejects fresh MIS orders after
# 15:10, so a 15:18 square-off could not be placed at all (2026-08-03: every
# one rejected) and 15:10 itself sits exactly on the boundary — the tick that
# fires at 15:10:00 is already too late. Five minutes of clearance costs a
# little divergence from the backtest and buys an exit that executes.
TMF_EXIT_MINUTE=5
# Rupee stop-loss cap per trade — the Backtest page's "SL Risk Filter" /
# "Max SL Risk". OFF, matching the Backtest page's default (its checkbox
# loads unchecked): live takes every valid setup, exactly the trade set the
# default backtest scores. With it ON, live skips setups the backtest counted
# — e.g. SIEMENS on 2026-08-04, sized stop ₹5,493 > ₹5,000.
# Set to true to cap per-trade rupee risk at TMF_MAX_SL_RISK instead; that
# is a deliberate divergence from the backtest, not a match to it.
TMF_USE_SL_RISK_FILTER=false
TMF_MAX_SL_RISK=5000

#--- EMA_CONFLUENCE -----------------------------------------------------------------------------------------------------------------------------

# ── EMA Confluence Breakout Algo (PAPER TRADE ONLY — futures, no real orders) ──
# Daily-swing scanner across every symbol in ema_symbol_universe.py, each
# using its own Direction/Target% default (same table as the Backtest page).
# ACTIVE gates paper fills only — the monitor thread always scans and logs
# signals regardless. Safe to leave on since no broker orders are ever placed.
EMA_CONFLUENCE_ACTIVE=true
# Start/Stop button state (persisted) — see TMF_ALGO_ENABLED above.
EMA_CONFLUENCE_ENABLED=true
EMA_CONFLUENCE_LOTS=1
# New-entry alerts. NOTIFY drives the in-app notification bell; TELEGRAM drives
# the Telegram message and additionally needs the two TELEGRAM_* credentials
# below — with either blank it silently does nothing and only the bell fires.
# Both default to on when unset.
EMA_CONFLUENCE_NOTIFY=true
EMA_CONFLUENCE_TELEGRAM=true

# ── OI Crossover alerts (scanner, every 3 min in-session) ──
# Fired when a cross is *confirmed* — the sweep after it saw the sign hold.
# That costs 3 minutes but drops the ~1-in-5 crosses that reverse immediately.
# NOTIFY drives the in-app bell, TELEGRAM the message (needs the TELEGRAM_*
# credentials below). Both off: the scanner screen is the way this is read, and
# the alerts were not worth the volume. Flip either back to 'true' to restore.
OIX_NOTIFY=false
OIX_TELEGRAM=false
# The gate, and it has to be tight: the scanner records ~460 crosses a day, so
# alerting on all of them would be the same as alerting on none. As set below
# this landed at 12 and 26 alerts on the two recorded sessions.
#   QUALITY         'strong' = the two legs moved in opposite directions (puts
#                   piling on while calls unwind, or the reverse). The tightest
#                   read there is. 'any' turns the gate off.
#   FIRST_CROSS_ONLY  only a symbol's opening turn; the later ones are chop.
#   MIN_SEPARATION  how far apart the legs were, as a share of the flow behind
#                   them (0-100). Left at 0 because it is redundant while
#                   QUALITY=strong — opposed legs are 100% separated by
#                   definition. Raise it only alongside QUALITY=any, where it
#                   becomes the thing keeping the volume sane (>=70 gives
#                   roughly 24-45/day, >=90 roughly 17-37).
#   MAX_PER_SCAN    safety valve — one grouped alert, the rest counted.
OIX_ALERT_MIN_SEPARATION=0
OIX_ALERT_QUALITY=strong
OIX_ALERT_FIRST_CROSS_ONLY=true
OIX_ALERT_MAX_PER_SCAN=15

# ── Expiry High/Low Breakout hourly scan (scheduler, 10:16–15:16 IST) ──
# The in-app bell always gets an entry every hour so you can see the scan ran.
# This flag only controls the Telegram message, which is sent solely when at
# least one stock broke out — an hourly "no breakouts" ping would be noise.
# Needs the two TELEGRAM_* credentials below; defaults to on when unset.
EXPIRY_HL_TELEGRAM=true

#--- TELEGRAM_BOT ---------------------------------------------------------------------------------------------------------------------------------

# ── Telegram Bot API — algo entry alerts + the options-chart trend alert ──
# Free, with no send window to keep open and no per-message billing.
# BOT_TOKEN: message @BotFather → /newbot → it hands you the token.
# CHAT_ID:   send your new bot any message, then open
#            https://api.telegram.org/bot<TOKEN>/getUpdates and read
#            result[0].message.chat.id. A negative id is a group/channel,
#            which is how you fan alerts out to more than one person.
# The bot can only message a chat that has messaged it first — so send that
# one message before expecting alerts. It never expires after that.
TELEGRAM_BOT_TOKEN=8816298457:AAERPG-ZM65pdWlPoyRGeTmeiNh8v96KjZY
TELEGRAM_CHAT_ID=611341055

