# FLASK_HOST: Bind to all interfaces to allow access from other devices
FLASK_HOST=127.0.0.1
# INTRINSIC_ORDER_LOTS: Number of lots to buy/sell when using the Intrinsic Levels order buttons
INTRINSIC_ORDER_LOTS=1
# FLASK_PORT: Default port
FLASK_PORT=5000

# ============================================
# BROKER CONFIGURATIONS (Object-based)
